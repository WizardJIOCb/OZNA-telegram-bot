<?php

namespace Longman\TelegramBot\Commands\SystemCommands\Services;

/**
 * Admin service for managing administrative functions
 */
class AdminService
{
    private MessageService $messageService;
    private ?DatabaseService $databaseService = null;
    private bool $databaseAvailable = false;
    
    // ID супер-админов (пока захардкодим, потом можно вынести в базу)
    private array $superAdmins = [
        230379668,  // Ваш ID (из StartCommand.php)
        5261465966  // Боря
        // 1090118386  // Близи (удален из суперадминов)
        // 444234398   // Олег olegpysh (удален из суперадминов)
    ];

    // Текущий список проектов (пока статический, потом можно в базу)
    private array $projects = [
        'ОИ834', 'ОИ651', 'ОИ696', 'ОИ795',
        'ОИ810', 'ОИ768', 'ОИ837', 'ОИ562',
        'ОИ788', 'ОИ860', 'ОИ862',
        'БКНС115', 'БКНС120'
    ];

    // Список заявок на доступ
    private array $accessRequests = [];

    public function __construct(MessageService $messageService)
    {
        $this->messageService = $messageService;
        
        // Проверяем доступность MySQLi расширения
        $this->databaseAvailable = extension_loaded('mysqli');
        
        // Инициализируем DatabaseService только если расширение доступно
        if ($this->databaseAvailable) {
            $this->databaseService = new DatabaseService();
        }
        
        // Загружаем проекты из файла при создании сервиса
        $this->loadProjectsFromFile();
        
        // Загружаем заявки на доступ из файла
        $this->loadAccessRequestsFromFile();
    }

    /**
     * Проверяет является ли пользователь супер-админом
     */
    public function isSuperAdmin(int $userId): bool
    {
        $isSuperAdmin = in_array($userId, $this->superAdmins);
        
        // Debug: Log super admin check
        error_log("AdminService: User {$userId} is super admin: " . ($isSuperAdmin ? "true" : "false"));
        error_log("AdminService: Super admin list: " . json_encode($this->superAdmins));
        
        return $isSuperAdmin;
    }

    /**
     * Получить список супер-админов
     */
    public function getSuperAdmins(): array
    {
        return $this->superAdmins;
    }

    /**
     * Проверяет уровень доступа пользователя
     */
    public function getUserAccessLevel(int $userId): int
    {
        // Сначала проверяем, является ли пользователь супер-админом
        if ($this->isSuperAdmin($userId)) {
            error_log("AdminService: User {$userId} is super admin, returning ACCESS_LEVEL_SUPER_ADMIN");
            return DatabaseService::ACCESS_LEVEL_SUPER_ADMIN;
        }
        
        // Если база данных недоступна, возвращаем уровень пользователя по умолчанию
        if (!$this->databaseAvailable || $this->databaseService === null) {
            error_log("AdminService: Database not available, returning ACCESS_LEVEL_USER for user {$userId}");
            return DatabaseService::ACCESS_LEVEL_USER;
        }
        
        // Затем получаем уровень доступа из базы данных
        $dbLevel = $this->databaseService->getUserAccessLevel($userId);
        error_log("AdminService: User {$userId} database access level: {$dbLevel}");
        return $dbLevel;
    }

    /**
     * Проверяет, имеет ли пользователь определенный уровень доступа или выше
     */
    public function hasAccessLevel(int $userId, int $requiredLevel): bool
    {
        return $this->getUserAccessLevel($userId) >= $requiredLevel;
    }

    /**
     * Получить текстовое описание уровня доступа
     */
    public function getAccessLevelName(int $accessLevel): string
    {
        switch ($accessLevel) {
            case DatabaseService::ACCESS_LEVEL_GUEST:
                return "Гость";
            case DatabaseService::ACCESS_LEVEL_USER:
                return "Пользователь";
            case DatabaseService::ACCESS_LEVEL_SUPERVISOR:
                return "Супервайзер";
            case DatabaseService::ACCESS_LEVEL_ADMIN:
                return "Администратор";
            case DatabaseService::ACCESS_LEVEL_SUPER_ADMIN:
                return "Суперадминистратор";
            default:
                return "Неизвестный уровень";
        }
    }

    /**
     * Обновляет уровень доступа пользователя
     */
    public function updateUserAccessLevel(int $userId, int $newLevel): bool
    {
        // Если база данных недоступна, не можем обновить уровень доступа
        if (!$this->databaseAvailable || $this->databaseService === null) {
            error_log("AdminService: Database not available, cannot update access level for user {$userId}");
            return false;
        }
        
        return $this->databaseService->updateUserAccessLevel($userId, $newLevel);
    }

    /**
     * Получить ФИО пользователя из профиля
     */
    public function getUserFio(int $userId): string
    {
        // Если база данных недоступна, не можем получить ФИО
        if (!$this->databaseAvailable || $this->databaseService === null) {
            error_log("AdminService: Database not available, cannot get FIO for user {$userId}");
            return '';
        }
        
        try {
            $userData = $this->databaseService->getUserData($userId);
            if (isset($userData['fio']) && !empty($userData['fio'])) {
                // Ensure UTF-8 encoding
                return $this->ensureUtf8Encoding($userData['fio']);
            }
        } catch (\Exception $e) {
            // Если не удалось получить ФИО, возвращаем пустую строку
        }
        
        return '';
    }

    /**
     * Установить ФИО пользователя
     */
    public function setUserFio(int $userId, string $fio): bool
    {
        // Если база данных недоступна, не можем установить ФИО
        if (!$this->databaseAvailable || $this->databaseService === null) {
            error_log("AdminService: Database not available, cannot set FIO for user {$userId}");
            return false;
        }
        
        try {
            return $this->databaseService->setUserFio($userId, $fio);
        } catch (\Exception $e) {
            error_log("AdminService: Error setting FIO for user {$userId}: " . $e->getMessage());
            return false;
        }
    }

    /**
     * Установить функциональное направление пользователя
     */
    public function setUserFunctionalDirection(int $userId, string $direction): bool
    {
        // Если база данных недоступна, не можем установить функциональное направление
        if (!$this->databaseAvailable || $this->databaseService === null) {
            error_log("AdminService: Database not available, cannot set functional direction for user {$userId}");
            return false;
        }
        
        try {
            return $this->databaseService->setUserFunctionalDirection($userId, $direction);
        } catch (\Exception $e) {
            error_log("AdminService: Error setting functional direction for user {$userId}: " . $e->getMessage());
            return false;
        }
    }

    /**
     * Добавить пользователя как администратора
     */
    public function addAdministrator(int $userId): bool
    {
        // Проверяем, что пользователь не является супер-админом (супер-админы всегда имеют максимальный уровень)
        if ($this->isSuperAdmin($userId)) {
            error_log("AdminService: Cannot add user {$userId} as admin because they are already a super admin");
            return false;
        }
        
        // Если база данных недоступна, не можем добавить администратора
        if (!$this->databaseAvailable || $this->databaseService === null) {
            error_log("AdminService: Database not available, cannot add administrator {$userId}");
            return false;
        }
        
        // Обновляем уровень доступа пользователя до администратора
        return $this->databaseService->updateUserAccessLevel($userId, DatabaseService::ACCESS_LEVEL_ADMIN);
    }

    /**
     * Получить всех администраторов (пользователей с уровнем доступа администратора)
     */
    public function getAllAdministrators(): array
    {
        // В текущей реализации нет прямого способа получить всех администраторов из базы данных
        // Эта функция будет реализована при необходимости с доработкой базы данных
        return [];
    }

    /**
     * Очистить список администраторов (сбросить уровень доступа всех администраторов до уровня пользователя)
     */
    public function clearAdministrators(): bool
    {
        // В текущей реализации нет прямого способа очистить список администраторов
        // потому что нет механизма для получения всех пользователей с определенным уровнем доступа
        // Эта функция будет реализована при необходимости с доработкой базы данных
        // Пока возвращаем true как заглушку
        return true;
    }

    /**
     * Получить список всех проектов
     */
    public function getAllProjects(): array
    {
        return $this->projects;
    }

    /**
     * Добавить новый проект
     */
    public function addProject(string $projectCode): bool
    {
        $projectCode = trim(strtoupper($projectCode));
        
        if (empty($projectCode)) {
            return false;
        }
        
        if (in_array($projectCode, $this->projects)) {
            return false; // Проект уже существует
        }
        
        $this->projects[] = $projectCode;
        
        // TODO: Сохранить в базу данных
        // Пока сохраняем в файл для простоты
        $this->saveProjectsToFile();
        
        return true;
    }

    /**
     * Удалить проект
     */
    public function deleteProject(string $projectCode): bool
    {
        $key = array_search($projectCode, $this->projects);
        
        if ($key === false) {
            return false; // Проект не найден
        }
        
        unset($this->projects[$key]);
        $this->projects = array_values($this->projects); // Переиндексация
        
        // TODO: Удалить из базы данных
        $this->saveProjectsToFile();
        
        return true;
    }

